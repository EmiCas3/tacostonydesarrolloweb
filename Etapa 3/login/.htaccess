# Bloquear acceso web directo a archivos sensibles
<FilesMatch "^(config\.php|config\.example\.php|schema\.sql|reflexion_entrega\.md|bitacora_cambios\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
